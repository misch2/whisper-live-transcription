<Window x:Class="TranscriptionClient.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Setup – Whisper Live Transcription"
        Height="470" Width="480"
        MinHeight="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource SurfaceBg}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- title -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- host + port -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- device filter -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- device picker -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- model + language -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- auto-scroll -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- theme -->
            <RowDefinition Height="*" MinHeight="16"/>
            <RowDefinition Height="Auto"/>  <!-- buttons -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Setup"
                   Foreground="{DynamicResource FgBrush}"
                   FontSize="17" FontWeight="SemiBold"/>

        <!-- Host + Port row -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server host"
                       Foreground="{DynamicResource FgDimBrush}"
                       FontSize="11" Margin="0,0,0,3"/>
            <TextBox   Grid.Row="1" Grid.Column="0" x:Name="TxtHost" Padding="5,4"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Port"
                       Foreground="{DynamicResource FgDimBrush}"
                       FontSize="11" Margin="0,0,0,3"/>
            <TextBox   Grid.Row="1" Grid.Column="2" x:Name="TxtPort" Padding="5,4"/>
        </Grid>

        <!-- Device name filter -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Device name filter (prefix)"
                       Foreground="{DynamicResource FgDimBrush}"
                       FontSize="11" Margin="0,0,0,3"/>
            <TextBox   Grid.Row="1" x:Name="TxtDeviceFilter"
                       Padding="5,4"
                       ToolTip="Filter devices by name prefix. Leave empty to show all."
                       TextChanged="TxtDeviceFilter_TextChanged"/>
        </Grid>

        <!-- Audio device picker -->
        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Audio input device"
                       Foreground="{DynamicResource FgDimBrush}"
                       FontSize="11" Margin="0,0,0,3"/>
            <ComboBox  Grid.Row="1" x:Name="CmbDevice"
                       DisplayMemberPath="Name"/>
        </Grid>

        <!-- Model + Language row -->
        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Whisper model"
                       Foreground="{DynamicResource FgDimBrush}"
                       FontSize="11" Margin="0,0,0,3"/>
            <TextBox   Grid.Row="1" Grid.Column="0" x:Name="TxtModel" Padding="5,4"
                       ToolTip="Model name: tiny, base, small, medium, large-v3, turbo"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Language"
                       Foreground="{DynamicResource FgDimBrush}"
                       FontSize="11" Margin="0,0,0,3"/>
            <TextBox   Grid.Row="1" Grid.Column="2" x:Name="TxtLanguage" Padding="5,4"
                       ToolTip="Language code: en, cs, de, fr, etc."/>
        </Grid>

        <!-- Auto-scroll -->
        <CheckBox Grid.Row="10"
                  x:Name="ChkAutoScroll"
                  Content="Auto-scroll transcript"
                  Foreground="{DynamicResource FgBrush}"
                  FontSize="12"/>

        <!-- Theme selector -->
        <StackPanel Grid.Row="12" Orientation="Horizontal">
            <TextBlock Text="Theme:"
                       Foreground="{DynamicResource FgDimBrush}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <RadioButton x:Name="RbThemeSystem"
                         Content="System"
                         Foreground="{DynamicResource FgBrush}"
                         FontSize="12"
                         GroupName="Theme"
                         Margin="0,0,12,0"
                         VerticalAlignment="Center"/>
            <RadioButton x:Name="RbThemeLight"
                         Content="Light"
                         Foreground="{DynamicResource FgBrush}"
                         FontSize="12"
                         GroupName="Theme"
                         Margin="0,0,12,0"
                         VerticalAlignment="Center"/>
            <RadioButton x:Name="RbThemeDark"
                         Content="Dark"
                         Foreground="{DynamicResource FgBrush}"
                         FontSize="12"
                         GroupName="Theme"
                         VerticalAlignment="Center"/>
        </StackPanel>

        <!-- OK / Cancel -->
        <StackPanel Grid.Row="14" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnOk"
                    Content="OK"
                    Padding="18,6"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel"
                    Content="Cancel"
                    Padding="18,6"
                    IsCancel="True"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
