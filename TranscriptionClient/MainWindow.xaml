<Window x:Class="TranscriptionClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Whisper Live Transcription"
        Height="620" Width="860" MinHeight="480" MinWidth="600"
        Background="#1E1E2E">

    <Window.Resources>
        <!-- ── Palette ─────────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="SurfaceBrush"  Color="#2A2A3E"/>
        <SolidColorBrush x:Key="BorderBrush"   Color="#44475A"/>
        <SolidColorBrush x:Key="AccentBrush"   Color="#BD93F9"/>
        <SolidColorBrush x:Key="GreenBrush"    Color="#50FA7B"/>
        <SolidColorBrush x:Key="RedBrush"      Color="#FF5555"/>
        <SolidColorBrush x:Key="FgBrush"       Color="#F8F8F2"/>
        <SolidColorBrush x:Key="FgDimBrush"    Color="#6272A4"/>
        <SolidColorBrush x:Key="LiveBgBrush"   Color="#282A36"/>

        <!-- ── Label style ────────────────────────────────────────────── -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgDimBrush}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
        </Style>

        <!-- ── TextBox style ─────────────────────────────────────────── -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background"         Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"         Value="{StaticResource FgBrush}"/>
            <Setter Property="BorderBrush"        Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="Padding"            Value="6,4"/>
            <Setter Property="FontSize"           Value="13"/>
            <Setter Property="CaretBrush"         Value="{StaticResource FgBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── ComboBox style ────────────────────────────────────────── -->
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource FgBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="FontSize"        Value="13"/>
        </Style>

        <!-- ── Button base style ─────────────────────────────────────── -->
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Foreground"      Value="#F8F8F2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="18,7"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- settings card -->
            <RowDefinition Height="*"/>      <!-- transcript area -->
            <RowDefinition Height="Auto"/>   <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ══ Header ════════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Whisper Live Transcription"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Real-time speech-to-text via the transcription server"
                       Foreground="{StaticResource FgDimBrush}"
                       FontSize="11" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- ══ Settings card ═════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6"
                Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="80"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto" MinWidth="60"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto" MinWidth="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Host -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Server host" Style="{StaticResource LabelStyle}"/>
                <TextBox   Grid.Row="1" Grid.Column="0"
                           x:Name="TxtHost" Text="localhost"
                           Style="{StaticResource InputStyle}"/>

                <!-- Port -->
                <TextBlock Grid.Row="0" Grid.Column="3"
                           Text="Port" Style="{StaticResource LabelStyle}"/>
                <TextBox   Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2"
                           x:Name="TxtPort" Text="43007"
                           Style="{StaticResource InputStyle}"/>

                <!-- Audio device -->
                <TextBlock Grid.Row="0" Grid.Column="6" Grid.ColumnSpan="2"
                           Text="Audio input device" Style="{StaticResource LabelStyle}"/>
                <ComboBox  Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="2"
                           x:Name="CmbDevice"
                           Style="{StaticResource ComboStyle}"
                           DisplayMemberPath="Name"/>

                <!-- Connect / Disconnect buttons -->
                <Button Grid.Row="1" Grid.Column="9"
                        x:Name="BtnConnect"
                        Content="▶  Connect"
                        Background="{StaticResource GreenBrush}"
                        Foreground="#1E1E2E"
                        Style="{StaticResource ButtonStyle}"
                        Click="BtnConnect_Click"/>

                <Button Grid.Row="1" Grid.Column="11"
                        x:Name="BtnDisconnect"
                        Content="■  Disconnect"
                        Background="{StaticResource RedBrush}"
                        Style="{StaticResource ButtonStyle}"
                        IsEnabled="False"
                        Click="BtnDisconnect_Click"/>

                <!-- Device prefix filter row -->
                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="Device name filter (prefix)" Style="{StaticResource LabelStyle}"/>
                <TextBox   Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                           x:Name="TxtDeviceFilter"
                           Style="{StaticResource InputStyle}"
                           ToolTip="Filter devices by name prefix. Leave empty to show all."
                           TextChanged="TxtDeviceFilter_TextChanged"/>

                <!-- Auto-scroll checkbox -->
                <CheckBox  Grid.Row="3" Grid.Column="6" Grid.ColumnSpan="2"
                           Grid.RowSpan="2"
                           x:Name="ChkAutoScroll"
                           Content="Auto-scroll transcript"
                           Foreground="{StaticResource FgBrush}"
                           FontSize="12"
                           IsChecked="True"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══ Transcript area ═══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource LiveBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Toolbar inside the transcript area -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="6,6,0,0"
                        Padding="10,6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="TRANSCRIPT"
                                   Foreground="{StaticResource FgDimBrush}"
                                   FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right"
                                Content="Clear"
                                Background="Transparent"
                                Foreground="{StaticResource FgDimBrush}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrush}"
                                Padding="10,3" FontSize="11"
                                Cursor="Hand"
                                Click="BtnClear_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="3"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button DockPanel.Dock="Right" Margin="0,0,6,0"
                                Content="Copy all"
                                Background="Transparent"
                                Foreground="{StaticResource FgDimBrush}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrush}"
                                Padding="10,3" FontSize="11"
                                Cursor="Hand"
                                Click="BtnCopyAll_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="3"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- Scrollable transcript -->
                <ScrollViewer Grid.Row="1" x:Name="TranscriptScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="12,8">
                    <StackPanel x:Name="TranscriptPanel"/>
                </ScrollViewer>

                <!-- Live (interim) line at the bottom -->
                <Border Grid.Row="2"
                        Background="#22BD93F9"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,6">
                    <TextBlock x:Name="TxtLive"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="13" FontStyle="Italic"
                               TextWrapping="Wrap"
                               Text="(live transcription will appear here)"/>
                </Border>
            </Grid>
        </Border>

        <!-- ══ Status bar ════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="4" Padding="10,5" Margin="0,10,0,0">
            <DockPanel>
                <Ellipse x:Name="StatusDot"
                         Width="8" Height="8"
                         Fill="{StaticResource FgDimBrush}"
                         DockPanel.Dock="Left"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStatus"
                           Text="Disconnected"
                           Foreground="{StaticResource FgDimBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
