<Window x:Class="TranscriptionClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Whisper Live Transcription"
        Height="560" Width="860" MinHeight="400" MinWidth="500"
        Background="#1E1E2E">

    <Window.Resources>
        <!-- ── Palette ─────────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#2A2A3E"/>
        <SolidColorBrush x:Key="BorderBrush"  Color="#44475A"/>
        <SolidColorBrush x:Key="AccentBrush"  Color="#BD93F9"/>
        <SolidColorBrush x:Key="GreenBrush"   Color="#50FA7B"/>
        <SolidColorBrush x:Key="RedBrush"     Color="#FF5555"/>
        <SolidColorBrush x:Key="FgBrush"      Color="#F8F8F2"/>
        <SolidColorBrush x:Key="FgDimBrush"   Color="#6272A4"/>
        <SolidColorBrush x:Key="LiveBgBrush"  Color="#282A36"/>

        <!-- ── Button base style ─────────────────────────────────────── -->
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Foreground"      Value="#F8F8F2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="18,7"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Icon-button style (circular, no padding text) ─────────── -->
        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Padding"   Value="8,6"/>
            <Setter Property="FontSize"  Value="16"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header + toolbar -->
            <RowDefinition Height="*"/>     <!-- transcript area -->
            <RowDefinition Height="Auto"/>  <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ══ Header + toolbar ══════════════════════════════════════════════ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <!-- Setup icon on the far right -->
            <Button DockPanel.Dock="Right"
                    x:Name="BtnSetup"
                    Content="⚙"
                    Background="{StaticResource SurfaceBrush}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="Setup"
                    Click="BtnSetup_Click"
                    VerticalAlignment="Center"/>

            <!-- Disconnect button -->
            <Button DockPanel.Dock="Right" Margin="0,0,8,0"
                    x:Name="BtnDisconnect"
                    Content="■  Disconnect"
                    Background="{StaticResource RedBrush}"
                    Style="{StaticResource ButtonStyle}"
                    IsEnabled="False"
                    VerticalAlignment="Center"
                    Click="BtnDisconnect_Click"/>

            <!-- Connect button -->
            <Button DockPanel.Dock="Right" Margin="0,0,8,0"
                    x:Name="BtnConnect"
                    Content="▶  Connect"
                    Background="{StaticResource GreenBrush}"
                    Foreground="#1E1E2E"
                    Style="{StaticResource ButtonStyle}"
                    VerticalAlignment="Center"
                    Click="BtnConnect_Click"/>

            <!-- Title block -->
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Whisper Live Transcription"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Real-time speech-to-text via the transcription server"
                           Foreground="{StaticResource FgDimBrush}"
                           FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ══ Transcript area ═══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource LiveBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Toolbar inside the transcript area -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="6,6,0,0"
                        Padding="10,6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="TRANSCRIPT"
                                   Foreground="{StaticResource FgDimBrush}"
                                   FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right"
                                Content="Clear"
                                Background="Transparent"
                                Foreground="{StaticResource FgDimBrush}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrush}"
                                Padding="10,3" FontSize="11"
                                Cursor="Hand"
                                Click="BtnClear_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="3"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button DockPanel.Dock="Right" Margin="0,0,6,0"
                                Content="Copy all"
                                Background="Transparent"
                                Foreground="{StaticResource FgDimBrush}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrush}"
                                Padding="10,3" FontSize="11"
                                Cursor="Hand"
                                Click="BtnCopyAll_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="3"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- Scrollable transcript -->
                <ScrollViewer Grid.Row="1" x:Name="TranscriptScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="12,8">
                    <StackPanel x:Name="TranscriptPanel"/>
                </ScrollViewer>

                <!-- Live (interim) line at the bottom -->
                <Border Grid.Row="2"
                        Background="#22BD93F9"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,6">
                    <TextBlock x:Name="TxtLive"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="13" FontStyle="Italic"
                               TextWrapping="Wrap"
                               Text="(live transcription will appear here)"/>
                </Border>
            </Grid>
        </Border>

        <!-- ══ Status bar ════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="4" Padding="10,5" Margin="0,10,0,0">
            <DockPanel>
                <Ellipse x:Name="StatusDot"
                         Width="8" Height="8"
                         Fill="{StaticResource FgDimBrush}"
                         DockPanel.Dock="Left"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStatus"
                           Text="Disconnected"
                           Foreground="{StaticResource FgDimBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
