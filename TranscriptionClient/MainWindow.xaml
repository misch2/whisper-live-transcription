<Window x:Class="TranscriptionClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Whisper Live Transcription"
        Height="560" Width="860" MinHeight="260" MinWidth="500"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource SurfaceBg}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Transcript area ═══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="0,0,0,1"
                        Padding="8,5">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Transcript"
                                   Foreground="{DynamicResource FgDimBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right"
                                Content="Clear"
                                Padding="10,3"
                                Click="BtnClear_Click"/>
                        <Button DockPanel.Dock="Right" Margin="0,0,6,0"
                                Content="Copy all"
                                Padding="10,3"
                                Click="BtnCopyAll_Click"/>
                    </DockPanel>
                </Border>

                <!-- Scrollable transcript -->
                <ScrollViewer Grid.Row="1" x:Name="TranscriptScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="10,8"
                              Background="{DynamicResource WindowBg}">
                    <StackPanel x:Name="TranscriptPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ══ Bottom bar ════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBg}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1" Padding="8,5" Margin="0,8,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        x:Name="BtnSetup"
                        Content="Settings"
                        Padding="12,4"
                        ToolTip="Setup"
                        Click="BtnSetup_Click"
                        VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Margin="0,0,6,0"
                        x:Name="BtnDisconnect"
                        Content="Disconnect"
                        Padding="12,4"
                        IsEnabled="False"
                        VerticalAlignment="Center"
                        Click="BtnDisconnect_Click"/>
                <Button DockPanel.Dock="Right" Margin="0,0,6,0"
                        x:Name="BtnConnect"
                        Content="Connect"
                        Padding="12,4"
                        VerticalAlignment="Center"
                        Click="BtnConnect_Click"/>

                <Ellipse x:Name="StatusDot"
                         Width="8" Height="8"
                         Fill="{DynamicResource FgDimBrush}"
                         DockPanel.Dock="Left"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStatus"
                           Text="Disconnected"
                           Foreground="{DynamicResource FgDimBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ══ Stats bar ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                x:Name="StatsBar"
                Background="{DynamicResource SurfaceBg}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1" Padding="8,4" Margin="0,4,0,0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Foreground="{DynamicResource FgDimBrush}" FontSize="11" Text="Net " VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtNetLag" FontSize="11" FontWeight="SemiBold" Text="— ms" VerticalAlignment="Center" MinWidth="54"/>

                <TextBlock Foreground="{DynamicResource FgDimBrush}" FontSize="11" Text="  Queue " VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtQueueLag" FontSize="11" FontWeight="SemiBold" Text="— ms" VerticalAlignment="Center" MinWidth="54"/>

                <TextBlock Foreground="{DynamicResource FgDimBrush}" FontSize="11" Text="  Transcription " VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTranscriptionLag" FontSize="11" FontWeight="SemiBold" Text="— ms" VerticalAlignment="Center" MinWidth="64"/>

                <TextBlock Foreground="{DynamicResource FgDimBrush}" FontSize="11" Text="  Depth " VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtQueueDepth" FontSize="11" FontWeight="SemiBold" Text="—" VerticalAlignment="Center" MinWidth="20"/>

                <TextBlock Foreground="{DynamicResource FgDimBrush}" FontSize="11" Text="  Skipped " VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtChunksSkipped" FontSize="11" FontWeight="SemiBold" Text="—" VerticalAlignment="Center" MinWidth="20"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
